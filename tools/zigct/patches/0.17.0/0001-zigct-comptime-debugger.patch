+//! zigct: a comptime debugger inside the compiler. Sema calls the entry points below while it
+//! evaluates comptime code (see the patch in tools/zigct/patches). Everything is a no-op unless
+//! `enabled`. Two modes:
+//!   - trace (`ZCT_TRACE` set): prints each statement and its locals to stderr (the CT-0 spike);
+//!   - dap (`zigct dap-comptime`): a Debug Adapter Protocol server on stdin/stdout. When a stop
+//!     is due, the compiler thread itself reads and answers requests until the client resumes,
+//!     so everything is read by the thread that owns it (single-threaded: `-j1`).
+const std = @import("std");
+const Io = std.Io;
+const Sema = @import("Sema.zig");
+const Zcu = @import("Zcu.zig");
+const Value = @import("Value.zig");
+const Type = @import("Type.zig");
+
+pub var enabled: bool = false;
+var dap: bool = false;
+var io: Io = undefined;
+
+const gpa = std.heap.page_allocator;
+
+// ---- frames and locals ----
+
+const Local = struct {
+    name: []const u8,
+    /// The value, or for `var` declarations a pointer to it (`ptr_ty` set): read at every stop.
+    val: ?Value,
+    ptr_ty: ?Type,
+    block: *Sema.Block,
+    /// The Sema that declared it: comptime allocations belong to one Sema instance.
+    sema: *Sema,
+    frame: usize,
+};
+
+const Frame = struct {
+    sema: *Sema,
+    inlining: ?*Sema.Block.Inlining,
+    name: []const u8,
+    /// Absolute path; empty until the first statement is seen.
+    file: []const u8 = "",
+    base_line: u32 = 0,
+    in_scope: bool = false,
+    resolved: bool = false,
+    line: u32 = 0,
+    col: u32 = 0,
+};
+
+const BodyMark = struct { locals: usize, pushed_frame: bool };
+
+var frames: std.ArrayList(Frame) = .empty;
+var bodies: std.ArrayList(BodyMark) = .empty;
+var locals: std.ArrayList(Local) = .empty;
+
+pub const Mark = usize;
+
+const Pending = struct { name: []const u8, val: ?Value };
+/// Arguments of a comptime call, noted before the callee's body is entered.
+var pending: std.ArrayList(Pending) = .empty;
+
+pub fn pendingParam(name: []const u8, val: ?Value) void {
+    pending.append(gpa, .{ .name = name, .val = val }) catch {};
+}
+
+pub fn enterBody(sema: *Sema, block: *Sema.Block) Mark {
+    var push = true;
+    if (frames.items.len > 0) {
+        const top = frames.items[frames.items.len - 1];
+        push = top.sema != sema or top.inlining != block.inlining;
+    }
+    if (push) frames.append(gpa, .{ .sema = sema, .inlining = block.inlining, .name = frameName(sema, block) }) catch @panic("OOM");
+    bodies.append(gpa, .{ .locals = locals.items.len, .pushed_frame = push }) catch @panic("OOM");
+    if (pending.items.len > 0) {
+        // Only a new inline-call frame takes them (a lexical body inside it has none pending).
+        if (push) for (pending.items) |p| {
+            locals.append(gpa, .{ .sema = sema, .name = p.name, .val = p.val, .ptr_ty = null, .block = block, .frame = frames.items.len - 1 }) catch {};
+        };
+        pending.clearRetainingCapacity();
+    }
+    return bodies.items.len;
+}
+
+pub fn exitBody(mark: Mark) void {
+    const b = bodies.items[mark - 1];
+    bodies.shrinkRetainingCapacity(mark - 1);
+    locals.shrinkRetainingCapacity(b.locals);
+    if (b.pushed_frame) {
+        if (target_active and frames.items.len == target_frame + 1) {
+            // The targeted block is done: the session ends here.
+            finish(0);
+            std.process.exit(0);
+        }
+        const f = frames.pop().?;
+        gpa.free(f.name);
+        gpa.free(f.file);
+    }
+}
+
+fn frameName(sema: *Sema, block: *Sema.Block) []const u8 {
+    const zcu = sema.pt.zcu;
+    const ip = &zcu.intern_pool;
+    const text: []const u8 = blk: {
+        if (block.inlining) |inl| {
+            if (!inl.is_generic_instantiation) {
+                const nav = ip.getNav(zcu.funcInfo(inl.func).owner_nav);
+                break :blk nav.name.toSlice(ip);
+            }
+            break :blk "generic instantiation";
+        }
+        if (sema.func_index != .none) break :blk ip.getNav(zcu.funcInfo(sema.func_index).owner_nav).name.toSlice(ip);
+        break :blk switch (sema.owner.unwrap()) {
+            .@"comptime" => "comptime",
+            .nav_val, .nav_ty => |nav| ip.getNav(nav).name.toSlice(ip),
+            else => "analysis",
+        };
+    };
+    return gpa.dupe(u8, text) catch @panic("OOM");
+}
+
+fn resolveFrame(f: *Frame) void {
+    f.resolved = true;
+    const sema = f.sema;
+    const zcu = sema.pt.zcu;
+    const ip = &zcu.intern_pool;
+    var file: ?*Zcu.File = null;
+    if (f.inlining) |inl| {
+        if (!inl.is_generic_instantiation) {
+            const nav = zcu.funcInfo(inl.func).owner_nav;
+            file = zcu.navFileScope(nav);
+            f.base_line = zcu.navSrcLine(nav) + zcu.funcInfo(inl.func).lbrace_line;
+        }
+    } else if (sema.func_index != .none) {
+        const info = zcu.funcInfo(sema.func_index);
+        file = zcu.navFileScope(info.owner_nav);
+        f.base_line = zcu.navSrcLine(info.owner_nav) + info.lbrace_line;
+    } else switch (sema.owner.unwrap()) {
+        .@"comptime" => |id| if (ip.getComptimeUnit(id).zir_index.resolveFull(ip)) |full| {
+            const fl = zcu.fileByIndex(full.file);
+            file = fl;
+            f.base_line = fl.zir.?.getDeclaration(full.inst).src_line;
+        },
+        .nav_val, .nav_ty => |nav| {
+            file = zcu.navFileScope(nav);
+            f.base_line = zcu.navSrcLine(nav);
+        },
+        else => {},
+    }
+    const fl = file orelse {
+        f.file = gpa.dupe(u8, "") catch @panic("OOM");
+        return;
+    };
+    f.file = fl.path.toAbsolute(&zcu.comp.dirs, gpa) catch @panic("OOM");
+    f.in_scope = (source_root.len == 0 or std.mem.startsWith(u8, f.file, source_root)) and
+        !(launch.cache_dir.len > 0 and std.mem.startsWith(u8, f.file, launch.cache_dir));
+}
+
+// ---- state shared with the protocol ----
+
+var source_root: []const u8 = "";
+var stop_on_entry = false;
+var target_file: []const u8 = "";
+var target_start: u32 = 0;
+var target_end: u32 = 0;
+var target_active = false;
+var target_frame: usize = 0;
+var entered = false;
+
+const StepKind = enum { run, in, over, out };
+var step: StepKind = .run;
+var step_depth: usize = 0;
+
+var break_compile_error = false;
+var break_compile_log = false;
+var exception_id: []const u8 = "compile_error";
+var break_quota = false;
+var branch_total: u64 = 0;
+
+/// file (absolute) -> sorted lines
+var breakpoints: std.StringHashMapUnmanaged(std.ArrayList(u32)) = .empty;
+
+var seq: i64 = 1;
+var terminated_sent = false;
+var stop_text: []const u8 = "";
+
+// ---- entry points called from Sema ----
+
+pub fn onVar(sema: *Sema, block: *Sema.Block, name: []const u8, val: ?Value, ptr_ty: ?Type) void {
+    if (frames.items.len == 0) return;
+    const f = &frames.items[frames.items.len - 1];
+    if (f.resolved and !f.in_scope) return;
+    locals.append(gpa, .{ .sema = sema, .name = name, .val = val, .ptr_ty = ptr_ty, .block = block, .frame = frames.items.len - 1 }) catch @panic("OOM");
+}
+
+pub fn onStmt(sema: *Sema, block: *Sema.Block, rel_line: u32, column: u32) void {
+    _ = sema;
+    _ = block;
+    pending.clearRetainingCapacity(); // arguments of a call whose body was never entered
+    if (frames.items.len == 0) return;
+    const f = &frames.items[frames.items.len - 1];
+    if (!f.resolved) resolveFrame(f);
+    if (!f.in_scope) return;
+    const line = f.base_line + rel_line + 1;
+    const col = column + 1;
+    // One source line often has several statement markers (a call has two): stop once per line.
+    const dup = f.line == line;
+    f.line = line;
+    f.col = col;
+    if (!dap) return traceStmt(f, line, col);
+
+    var reason: ?[]const u8 = null;
+    if (!entered) {
+        if (target_file.len > 0 and !(std.mem.eql(u8, f.file, target_file) and line >= target_start and line <= target_end)) return;
+        entered = true;
+        if (target_file.len > 0) {
+            target_active = true;
+            target_frame = frames.items.len - 1;
+        }
+        if (stop_on_entry) reason = "entry";
+    }
+    if (reason == null and !dup) {
+        if (breakpoints.get(f.file)) |lines| {
+            for (lines.items) |l| if (l == line) {
+                reason = "breakpoint";
+                break;
+            };
+        }
+        if (reason == null) switch (step) {
+            .run => {},
+            .in => reason = "step",
+            .over => if (frames.items.len <= step_depth) {
+                reason = "step";
+            },
+            .out => if (frames.items.len < step_depth) {
+                reason = "step";
+            },
+        };
+    }
+    if (reason) |r| stopHere(r, "");
+}
+
+pub fn onBranch(sema: *Sema) void {
+    branch_total += 1;
+    _ = sema;
+}
+
+/// `@compileLog(...)`: shown in the debug console; stops when asked to.
+pub fn onCompileLog(text: []const u8) void {
+    if (!dap) {
+        std.debug.print("[zct] @compileLog: {s}\n", .{text});
+        return;
+    }
+    if (!entered) return;
+    const line = std.fmt.allocPrint(gpa, "@compileLog: {s}\n", .{text}) catch return;
+    defer gpa.free(line);
+    event("output", .{ .category = "console", .output = line });
+    if (break_compile_log) {
+        exception_id = "compile_log";
+        stopHere("exception", std.mem.trimEnd(u8, line, "\n"));
+    }
+}
+
+pub fn onError(sema: *Sema, msg: []const u8) void {
+    _ = sema;
+    if (!dap) {
+        std.debug.print("[zct] ERROR raised: {s}\n", .{msg});
+        return;
+    }
+    if (break_compile_error and entered) {
+        exception_id = "compile_error";
+        stopHere("exception", msg);
+    }
+}
+
+// ---- types ----
+
+pub const TypePhase = enum { declared, layout, defaults };
+var types_seen: std.AutoHashMapUnmanaged(u64, void) = .empty;
+var types_layout: std.AutoHashMapUnmanaged(u32, void) = .empty;
+var types_known: std.AutoHashMapUnmanaged(u32, void) = .empty;
+
+fn anyInScope() bool {
+    for (frames.items) |f| if (f.resolved and f.in_scope) return true;
+    return false;
+}
+
+fn kindName(zcu: *Zcu, ty: Type) ?[]const u8 {
+    return switch (zcu.intern_pool.indexToKey(ty.toIntern())) {
+        .struct_type => "struct",
+        .union_type => "union",
+        .enum_type => "enum",
+        .opaque_type => "opaque",
+        else => null,
+    };
+}
+
+fn fieldCount(zcu: *Zcu, ty: Type) usize {
+    return switch (zcu.intern_pool.indexToKey(ty.toIntern())) {
+        .struct_type => ty.structFieldCount(zcu),
+        .enum_type => ty.enumFieldCount(zcu),
+        .union_type => ty.unionTagTypeHypothetical(zcu).enumFieldCount(zcu),
+        else => 0,
+    };
+}
+
+fn typeName(zcu: *Zcu, ty: Type) []u8 {
+    var buf: [300]u8 = undefined;
+    var w = Io.Writer.fixed(&buf);
+    w.print("{f}", .{ty.fmt(zcu)}) catch {};
+    return gpa.dupe(u8, w.buffered()) catch @panic("OOM");
+}
+
+/// A struct, union, enum or opaque type reached a new stage: declared (created), layout
+/// resolved (fields and size known), defaults resolved. Reported once per stage, only while
+/// something of the project is on the stack (so the standard library's own types show up
+/// when your code asks for them).
+pub fn onType(sema: *Sema, ty: Type, phase: TypePhase) void {
+    if (!dap or !entered) return;
+    const zcu = sema.pt.zcu;
+    const kind = kindName(zcu, ty) orelse return;
+    if (!anyInScope()) return;
+    const key = (@as(u64, @intFromEnum(ty.toIntern())) << 2) | @intFromEnum(phase);
+    const gop = types_seen.getOrPut(gpa, key) catch return;
+    if (gop.found_existing) return;
+    types_known.put(gpa, @intFromEnum(ty.toIntern()), {}) catch {};
+    if (phase == .layout) types_layout.put(gpa, @intFromEnum(ty.toIntern()), {}) catch {};
+    const name = typeName(zcu, ty);
+    defer gpa.free(name);
+    var file: []const u8 = "";
+    var file_owned: ?[]u8 = null;
+    defer if (file_owned) |f| gpa.free(f);
+    if (ty.typeDeclSrcLine(zcu)) |_| {
+        const ns = zcu.namespacePtr(ty.getNamespaceIndex(zcu));
+        if (ns.fileScope(zcu).path.toAbsolute(&zcu.comp.dirs, gpa)) |abs| {
+            file_owned = abs;
+            file = abs;
+        } else |_| {}
+    }
+    const top = if (frames.items.len > 0) frames.items[frames.items.len - 1] else null;
+    event("zigct/typeEvent", .{
+        .id = @intFromEnum(ty.toIntern()),
+        .name = name,
+        .kind = kind,
+        .phase = @tagName(phase),
+        // Field queries need the layout; before that the count is unknown (-1).
+        .fieldCount = if (phase == .declared) @as(i64, -1) else @as(i64, @intCast(fieldCount(zcu, ty))),
+        .file = file,
+        .line = ty.typeDeclSrcLine(zcu) orelse 0,
+        .requestedBy = if (top) |t| t.name else "",
+    });
+}
+
+/// `zigct/typeInfo {id}`: the fields of one type.
+fn typeInfo(rs: i64, cmd: []const u8, id: i64) void {
+    const sema = blk: {
+        // Any live Sema will do to reach the Zcu.
+        if (frames.items.len > 0) break :blk frames.items[0].sema;
+        respond(rs, cmd, false, null, "no analysis is running");
+        return;
+    };
+    const zcu = sema.pt.zcu;
+    const ip = &zcu.intern_pool;
+    // Only ids that were reported in a typeEvent: anything else may not be a type at all.
+    if (id < 0 or !types_known.contains(@intCast(id))) return respond(rs, cmd, false, null, "no such type");
+    const ty: Type = .fromInterned(@enumFromInt(@as(u32, @intCast(id))));
+    const kind = kindName(zcu, ty) orelse return respond(rs, cmd, false, null, "not a struct, union, enum or opaque type");
+    const has_layout = types_layout.contains(@intCast(id));
+    if (!has_layout) return respond(rs, cmd, false, null, "the fields are known once the type's layout is resolved");
+    const Field = struct { name: []const u8, type: []const u8, typeId: i64 = -1 };
+    var out: std.ArrayList(Field) = .empty;
+    defer {
+        for (out.items) |f| {
+            gpa.free(f.type);
+            gpa.free(@constCast(f.name));
+        }
+        out.deinit(gpa);
+    }
+    const n = fieldCount(zcu, ty);
+    for (0..@min(n, 500)) |i| {
+        switch (ip.indexToKey(ty.toIntern())) {
+            .struct_type => {
+                const ft = ty.fieldType(i, zcu);
+                const name = if (ty.structFieldName(i, zcu).unwrap()) |nm| gpa.dupe(u8, nm.toSlice(ip)) catch continue else std.fmt.allocPrint(gpa, "[{d}]", .{i}) catch continue;
+                out.append(gpa, .{ .name = name, .type = typeName(zcu, ft), .typeId = @intFromEnum(ft.toIntern()) }) catch {};
+            },
+            .enum_type => {
+                const name = gpa.dupe(u8, ty.enumFieldName(i, zcu).toSlice(ip)) catch continue;
+                out.append(gpa, .{ .name = name, .type = gpa.dupe(u8, "") catch continue }) catch {};
+            },
+            .union_type => {
+                const tag_ty = ty.unionTagTypeHypothetical(zcu);
+                const name = gpa.dupe(u8, tag_ty.enumFieldName(i, zcu).toSlice(ip)) catch continue;
+                const ft = ty.unionFieldTypeByIndex(i, zcu);
+                out.append(gpa, .{ .name = name, .type = typeName(zcu, ft), .typeId = @intFromEnum(ft.toIntern()) }) catch {};
+            },
+            else => {},
+        }
+    }
+    const name = typeName(zcu, ty);
+    defer gpa.free(name);
+    respond(rs, cmd, true, .{
+        .id = id,
+        .name = name,
+        .kind = kind,
+        .fields = out.items,
+        .size = if (has_layout) @as(i64, @intCast(ty.abiSize(zcu))) else -1,
+        .alignment = if (has_layout) @as(i64, @intCast(ty.abiAlignment(zcu).toByteUnits() orelse 0)) else -1,
+    }, null);
+}
+
+// ---- trace mode ----
+
+var stmt_count: u64 = 0;
+
+fn traceStmt(f: *Frame, line: u32, col: u32) void {
+    stmt_count += 1;
+    std.debug.print("[zct] stmt #{d} {s}:{d}:{d} depth={d}", .{ stmt_count, f.file, line, col, frames.items.len });
+    std.debug.print("\n", .{});
+}
+
+// ---- values ----
+
+fn fmtValue(sema: *Sema, val: ?Value) []u8 {
+    const v = val orelse return gpa.dupe(u8, "<not comptime-known>") catch @panic("OOM");
+    var buf: [400]u8 = undefined;
+    var w = Io.Writer.fixed(&buf);
+    w.print("{f}", .{v.fmtValueSema(sema)}) catch {};
+    return gpa.dupe(u8, w.buffered()) catch @panic("OOM");
+}
+
+fn localValue(l: Local) ?Value {
+    return if (l.ptr_ty) |pt| (if (l.val) |pv| l.sema.zctDeref(l.block, pv, pt) else null) else l.val;
+}
+
+// ---- structured values ----
+
+/// A value the client may expand: `variablesReference = handle_base + index`. Cleared on resume.
+const Handle = struct { val: Value, sema: *Sema, block: *Sema.Block };
+var handles: std.ArrayList(Handle) = .empty;
+const handle_base: i64 = 1_000_000;
+const max_children = 200;
+
+const Child = struct {
+    name: []const u8,
+    /// Owned.
+    text: []u8,
+    ref: i64 = 0,
+    owned_name: bool = false,
+};
+
+fn freeChildren(list: *std.ArrayList(Child)) void {
+    for (list.items) |c| {
+        gpa.free(c.text);
+        if (c.owned_name) gpa.free(@constCast(c.name));
+    }
+    list.deinit(gpa);
+}
+
+/// Can `val` be opened? (Cheap: looks at the kind only.)
+fn expandable(sema: *Sema, block: *Sema.Block, val: Value) bool {
+    const zcu = sema.pt.zcu;
+    const ip = &zcu.intern_pool;
+    return switch (ip.indexToKey(val.toIntern())) {
+        .aggregate => |agg| ip.aggregateTypeLen(agg.ty) > 0,
+        .un => true,
+        .opt => |o| o.val != .none,
+        .slice => Value.fromInterned(ip.sliceLen(val.toIntern())).toUnsignedInt(zcu) > 0,
+        .ptr => blk: {
+            const ty = val.typeOf(zcu);
+            if (ty.zigTypeTag(zcu) != .pointer or ty.ptrSize(zcu) != .one) break :blk false;
+            const pointee = sema.zctDeref(block, val, ty) orelse break :blk false;
+            break :blk switch (ip.indexToKey(pointee.toIntern())) {
+                .aggregate, .un, .opt, .slice, .ptr => true,
+                else => false,
+            };
+        },
+        .struct_type => true,
+        else => false,
+    };
+}
+
+fn makeHandle(sema: *Sema, block: *Sema.Block, val: Value) i64 {
+    if (!expandable(sema, block, val)) return 0;
+    handles.append(gpa, .{ .val = val, .sema = sema, .block = block }) catch return 0;
+    return handle_base + @as(i64, @intCast(handles.items.len - 1));
+}
+
+fn addChild(list: *std.ArrayList(Child), sema: *Sema, block: *Sema.Block, name: []const u8, owned: bool, val: ?Value) void {
+    const text = fmtValue(sema, val);
+    const ref = if (val) |v| makeHandle(sema, block, v) else 0;
+    list.append(gpa, .{ .name = name, .text = text, .ref = ref, .owned_name = owned }) catch {
+        gpa.free(text);
+        if (owned) gpa.free(@constCast(name));
+    };
+}
+
+fn indexName(i: usize) []const u8 {
+    return std.fmt.allocPrint(gpa, "[{d}]", .{i}) catch "[?]";
+}
+
+fn childrenOf(h: Handle, list: *std.ArrayList(Child)) void {
+    const sema = h.sema;
+    const pt = sema.pt;
+    const zcu = pt.zcu;
+    const ip = &zcu.intern_pool;
+    const val = h.val;
+    switch (ip.indexToKey(val.toIntern())) {
+        .aggregate => |agg| {
+            const t = Type.fromInterned(agg.ty);
+            const n: usize = @intCast(ip.aggregateTypeLen(agg.ty));
+            const is_struct = t.zigTypeTag(zcu) == .@"struct";
+            for (0..@min(n, max_children)) |i| {
+                const v = (if (is_struct) val.fieldValue(pt, i) else val.elemValue(pt, i)) catch continue;
+                if (is_struct) {
+                    if (t.structFieldName(i, zcu).unwrap()) |nm| {
+                        addChild(list, sema, h.block, gpa.dupe(u8, nm.toSlice(ip)) catch continue, true, v);
+                        continue;
+                    }
+                }
+                addChild(list, sema, h.block, indexName(i), true, v);
+            }
+        },
+        .opt => |o| if (o.val != .none) addChild(list, sema, h.block, "payload", false, Value.fromInterned(o.val)),
+        .un => |u| {
+            if (u.tag != .none) {
+                const tag_text = fmtValue(sema, Value.fromInterned(u.tag));
+                defer gpa.free(tag_text);
+                const name = std.mem.trimStart(u8, tag_text, ".");
+                addChild(list, sema, h.block, gpa.dupe(u8, name) catch return, true, Value.fromInterned(u.val));
+            } else addChild(list, sema, h.block, "value", false, Value.fromInterned(u.val));
+        },
+        .slice => |sl| {
+            const ty = Type.fromInterned(sl.ty);
+            const len: u64 = Value.fromInterned(sl.len).toUnsignedInt(zcu);
+            const elem = ty.childType(zcu);
+            const arr_ty = pt.arrayType(.{ .len = len, .child = elem.toIntern() }) catch return;
+            const pinfo = ip.indexToKey(ip.slicePtrType(sl.ty)).ptr_type;
+            const ptr_ty = pt.ptrType(.{ .child = arr_ty.toIntern(), .flags = .{ .size = .one, .is_const = pinfo.flags.is_const } }) catch return;
+            const pv = pt.getCoerced(Value.fromInterned(sl.ptr), ptr_ty) catch return;
+            const arr = sema.zctDeref(h.block, pv, ptr_ty) orelse return;
+            const n: usize = @intCast(@min(len, max_children));
+            for (0..n) |i| {
+                const v = arr.elemValue(pt, i) catch continue;
+                addChild(list, sema, h.block, indexName(i), true, v);
+            }
+        },
+        .ptr => {
+            const ty = val.typeOf(zcu);
+            if (ty.zigTypeTag(zcu) == .pointer and ty.ptrSize(zcu) == .one) {
+                addChild(list, sema, h.block, "*", false, sema.zctDeref(h.block, val, ty));
+            }
+        },
+        .struct_type => {
+            const ty = val.toType();
+            const n = ty.structFieldCount(zcu);
+            for (0..@min(n, max_children)) |i| {
+                const ft = ty.fieldType(i, zcu);
+                const name: []const u8 = if (ty.structFieldName(i, zcu).unwrap()) |nm| (gpa.dupe(u8, nm.toSlice(ip)) catch continue) else indexName(i);
+                addChild(list, sema, h.block, name, true, Value.fromInterned(ft.toIntern()));
+            }
+        },
+        else => {},
+    }
+}
+
+// ---- protocol ----
+
+var in_buf: [64 * 1024]u8 = undefined;
+var in_reader: Io.File.Reader = undefined;
+var out_buf: [16 * 1024]u8 = undefined;
+var out_writer: Io.File.Writer = undefined;
+
+/// Zigct's own start-up options, from `launch`.
+pub const Launch = struct {
+    /// Arguments for `zig build-obj` (root file, modules, flags).
+    zig_args: []const []const u8 = &.{},
+    cache_dir: []const u8 = "",
+    /// Analyze like `zig test` (the file's `test` declarations are analyzed): for blocks inside tests.
+    test_mode: bool = false,
+};
+pub var launch: Launch = .{};
+
+pub fn initDap(io_: Io) void {
+    io = io_;
+    enabled = true;
+    dap = true;
+    in_reader = Io.File.stdin().readerStreaming(io, &in_buf);
+    out_writer = Io.File.stdout().writer(io, &out_buf);
+}
+
+pub fn enableTrace() void {
+    enabled = true;
+}
+
+fn readMessage() ?std.json.Parsed(std.json.Value) {
+    const in = &in_reader.interface;
+    var len: usize = 0;
+    while (true) {
+        const line = in.takeDelimiterInclusive('\n') catch return null;
+        const t = std.mem.trim(u8, line, "\r\n");
+        if (t.len == 0) break;
+        const prefix = "Content-Length:";
+        if (std.ascii.startsWithIgnoreCase(t, prefix)) len = std.fmt.parseInt(usize, std.mem.trim(u8, t[prefix.len..], " "), 10) catch return null;
+    }
+    if (len == 0) return null;
+    const body = in.readAlloc(gpa, len) catch return null;
+    defer gpa.free(body);
+    return std.json.parseFromSlice(std.json.Value, gpa, body, .{ .allocate = .alloc_always }) catch null;
+}
+
+fn sendRaw(json: []const u8) void {
+    const out = &out_writer.interface;
+    out.print("Content-Length: {d}\r\n\r\n", .{json.len}) catch return;
+    out.writeAll(json) catch return;
+    out.flush() catch return;
+}
+
+fn send(msg: anytype) void {
+    const json = std.json.Stringify.valueAlloc(gpa, msg, .{ .emit_null_optional_fields = false }) catch return;
+    defer gpa.free(json);
+    sendRaw(json);
+}
+
+fn event(name: []const u8, body: anytype) void {
+    seq += 1;
+    send(.{ .seq = seq, .type = "event", .event = name, .body = body });
+}
+
+fn respond(req_seq: i64, command: []const u8, ok: bool, body: anytype, message: ?[]const u8) void {
+    seq += 1;
+    send(.{ .seq = seq, .type = "response", .request_seq = req_seq, .success = ok, .command = command, .message = message, .body = body });
+}
+
+fn str(v: std.json.Value, key: []const u8) ?[]const u8 {
+    if (v != .object) return null;
+    const x = v.object.get(key) orelse return null;
+    return if (x == .string) x.string else null;
+}
+
+fn int(v: std.json.Value, key: []const u8) ?i64 {
+    if (v != .object) return null;
+    const x = v.object.get(key) orelse return null;
+    return if (x == .integer) x.integer else null;
+}
+
+fn boolean(v: std.json.Value, key: []const u8) ?bool {
+    if (v != .object) return null;
+    const x = v.object.get(key) orelse return null;
+    return if (x == .bool) x.bool else null;
+}
+
+fn field(v: std.json.Value, key: []const u8) ?std.json.Value {
+    if (v != .object) return null;
+    return v.object.get(key);
+}
+
+fn setBreakpoints(args: std.json.Value) []const u32 {
+    const path = if (field(args, "source")) |s| str(s, "path") orelse "" else "";
+    var lines: std.ArrayList(u32) = .empty;
+    if (field(args, "breakpoints")) |list| if (list == .array) for (list.array.items) |b| {
+        if (int(b, "line")) |l| if (l > 0) lines.append(gpa, @intCast(l)) catch {};
+    };
+    if (path.len > 0) {
+        const key = gpa.dupe(u8, path) catch return &.{};
+        if (breakpoints.fetchRemove(key)) |old| {
+            gpa.free(old.key);
+            var o = old.value;
+            o.deinit(gpa);
+        }
+        breakpoints.put(gpa, key, lines) catch {};
+        return lines.items;
+    }
+    return &.{};
+}
+
+const Done = enum { configured, resume_run, disconnect };
+
+/// Answer requests until the client lets the compiler go on. `stopped` is false while setting up.
+fn serve(stopped: bool) Done {
+    while (true) {
+        const parsed = readMessage() orelse return .disconnect;
+        defer parsed.deinit();
+        const m = parsed.value;
+        const cmd = str(m, "command") orelse continue;
+        const rs: i64 = int(m, "seq") orelse 0;
+        const args = field(m, "arguments") orelse .null;
+        if (eq(cmd, "initialize")) {
+            respond(rs, cmd, true, .{
+                .supportsConfigurationDoneRequest = true,
+                .supportsExceptionInfoRequest = true,
+                .exceptionBreakpointFilters = [_]struct { filter: []const u8, label: []const u8, default: bool }{
+                    .{ .filter = "compile_error", .label = "Compile errors", .default = false },
+                    .{ .filter = "compile_log", .label = "@compileLog calls", .default = false },
+                },
+            }, null);
+        } else if (eq(cmd, "launch")) {
+            applyLaunch(args);
+            respond(rs, cmd, true, null, null);
+            event("initialized", null);
+        } else if (eq(cmd, "setBreakpoints")) {
+            const lines = setBreakpoints(args);
+            var out: std.ArrayList(struct { verified: bool, line: u32 }) = .empty;
+            defer out.deinit(gpa);
+            for (lines) |l| out.append(gpa, .{ .verified = true, .line = l }) catch {};
+            respond(rs, cmd, true, .{ .breakpoints = out.items }, null);
+        } else if (eq(cmd, "setExceptionBreakpoints")) {
+            break_compile_error = false;
+            break_compile_log = false;
+            if (field(args, "filters")) |fl| if (fl == .array) for (fl.array.items) |x| {
+                if (x != .string) continue;
+                if (eq(x.string, "compile_error")) break_compile_error = true;
+                if (eq(x.string, "compile_log")) break_compile_log = true;
+            };
+            respond(rs, cmd, true, struct {}{}, null);
+        } else if (eq(cmd, "configurationDone")) {
+            respond(rs, cmd, true, null, null);
+            return .configured;
+        } else if (eq(cmd, "threads")) {
+            respond(rs, cmd, true, .{ .threads = [_]struct { id: i64, name: []const u8 }{.{ .id = 1, .name = "semantic analysis" }} }, null);
+        } else if (eq(cmd, "stackTrace")) {
+            stackTrace(rs, cmd);
+        } else if (eq(cmd, "scopes")) {
+            const fid = int(args, "frameId") orelse 0;
+            respond(rs, cmd, true, .{ .scopes = [_]struct { name: []const u8, variablesReference: i64, expensive: bool }{
+                .{ .name = "Locals", .variablesReference = fid + 1, .expensive = false },
+                .{ .name = "Compiler", .variablesReference = analysis_base + fid, .expensive = false },
+            } }, null);
+        } else if (eq(cmd, "variables")) {
+            variablesOf(rs, cmd, int(args, "variablesReference") orelse 1);
+        } else if (eq(cmd, "zigct/typeInfo")) {
+            typeInfo(rs, cmd, int(args, "id") orelse -1);
+        } else if (eq(cmd, "exceptionInfo")) {
+            respond(rs, cmd, true, .{ .exceptionId = exception_id, .description = stop_text, .breakMode = "always" }, null);
+        } else if (eq(cmd, "continue")) {
+            respond(rs, cmd, true, .{ .allThreadsContinued = true }, null);
+            step = .run;
+            if (stopped) return .resume_run;
+        } else if (eq(cmd, "next") or eq(cmd, "stepIn") or eq(cmd, "stepOut")) {
+            respond(rs, cmd, true, null, null);
+            step = if (eq(cmd, "next")) .over else if (eq(cmd, "stepIn")) .in else .out;
+            step_depth = frames.items.len;
+            if (stopped) return .resume_run;
+        } else if (eq(cmd, "disconnect") or eq(cmd, "terminate")) {
+            respond(rs, cmd, true, null, null);
+            return .disconnect;
+        } else {
+            respond(rs, cmd, false, null, "unsupported request");
+        }
+    }
+}
+
+fn eq(a: []const u8, b: []const u8) bool {
+    return std.mem.eql(u8, a, b);
+}
+
+fn applyLaunch(args: std.json.Value) void {
+    if (str(args, "sourceRoot")) |s| source_root = gpa.dupe(u8, s) catch "";
+    stop_on_entry = boolean(args, "stopOnEntry") orelse false;
+    launch.test_mode = boolean(args, "testMode") orelse false;
+    if (str(args, "cacheDir")) |s| launch.cache_dir = gpa.dupe(u8, s) catch "";
+    if (field(args, "target")) |t| {
+        if (str(t, "file")) |f| target_file = gpa.dupe(u8, f) catch "";
+        target_start = @intCast(@max(int(t, "startLine") orelse 0, 0));
+        target_end = @intCast(@max(int(t, "endLine") orelse std.math.maxInt(i32), 0));
+    }
+    if (field(args, "zigArgs")) |za| if (za == .array) {
+        var list: std.ArrayList([]const u8) = .empty;
+        for (za.array.items) |x| if (x == .string) list.append(gpa, gpa.dupe(u8, x.string) catch continue) catch {};
+        launch.zig_args = list.items;
+    };
+}
+
+fn stackTrace(rs: i64, cmd: []const u8) void {
+    const Out = struct {
+        id: i64,
+        name: []const u8,
+        source: struct { path: []const u8 },
+        line: u32,
+        column: u32,
+        presentationHint: ?[]const u8 = null,
+    };
+    var out: std.ArrayList(Out) = .empty;
+    defer out.deinit(gpa);
+    var i = frames.items.len;
+    while (i > 0) {
+        i -= 1;
+        const f = frames.items[i];
+        if (!f.resolved or f.line == 0) continue;
+        out.append(gpa, .{ .id = @intCast(i), .name = f.name, .source = .{ .path = f.file }, .line = f.line, .column = f.col, .presentationHint = if (f.in_scope) null else "subtle" }) catch {};
+    }
+    respond(rs, cmd, true, .{ .stackFrames = out.items, .totalFrames = out.items.len }, null);
+}
+
+fn variablesOf(rs: i64, cmd: []const u8, reference: i64) void {
+    const Out = struct { name: []const u8, value: []const u8, variablesReference: i64 = 0 };
+    var out: std.ArrayList(Out) = .empty;
+    defer out.deinit(gpa);
+    var kids: std.ArrayList(Child) = .empty;
+    defer freeChildren(&kids);
+    if (reference >= handle_base) {
+        const i: usize = @intCast(reference - handle_base);
+        if (i < handles.items.len) childrenOf(handles.items[i], &kids);
+    } else if (reference >= analysis_base) {
+        const f: usize = @intCast(reference - analysis_base);
+        if (f < frames.items.len) analysisVars(frames.items[f].sema, &kids);
+    } else {
+        for (locals.items) |l| {
+            if (l.frame != reference - 1) continue;
+            addChild(&kids, l.sema, l.block, l.name, false, localValue(l));
+        }
+    }
+    for (kids.items) |c| out.append(gpa, .{ .name = c.name, .value = c.text, .variablesReference = c.ref }) catch {};
+    respond(rs, cmd, true, .{ .variables = out.items }, null);
+}
+
+const analysis_base: i64 = 100_000;
+
+/// What the compiler is doing, as variables of the "Compiler" scope.
+fn analysisVars(sema: *Sema, list: *std.ArrayList(Child)) void {
+    const text = std.fmt.allocPrint(gpa, "{d} / {d}", .{ sema.branch_count, sema.branch_quota }) catch return;
+    list.append(gpa, .{ .name = "backward branches / quota", .text = text }) catch gpa.free(text);
+    const t2 = std.fmt.allocPrint(gpa, "{d}", .{branch_total}) catch return;
+    list.append(gpa, .{ .name = "backward branches (all analysis)", .text = t2 }) catch gpa.free(t2);
+}
+
+/// Pause the compiler here: tell the client, then serve requests until it resumes.
+fn stopHere(reason: []const u8, text: []const u8) void {
+    stop_text = text;
+    event("stopped", .{ .reason = reason, .threadId = 1, .allThreadsStopped = true, .text = text });
+    defer handles.clearRetainingCapacity();
+    switch (serve(true)) {
+        .resume_run => {},
+        else => {
+            finish(0);
+            std.process.exit(0);
+        },
+    }
+}
+
+/// Before the compilation starts: run the set-up handshake. Returns false when the client left.
+pub fn handshake() bool {
+    return serve(false) == .configured;
+}
+
+/// The compilation ended (or the session did): tell the client.
+pub fn finish(code: u8) void {
+    if (!dap or terminated_sent) return;
+    terminated_sent = true;
+    event("exited", .{ .exitCode = code });
+    event("terminated", struct {}{});
+}
