+//! zigct spike (CT-0): observes Sema's comptime evaluation. All entry points are called from
+//! `Sema.zig` and cost one branch on `enabled` when no session is active.
+const std = @import("std");
+const Sema = @import("Sema.zig");
+const Zcu = @import("Zcu.zig");
+const Value = @import("Value.zig");
+const Type = @import("Type.zig");
+
+/// Set from the environment (`ZCT_TRACE`) in `main.zig`.
+pub var enabled: bool = false;
+
+const gpa = std.heap.page_allocator;
+
+const Local = struct {
+    name: []const u8,
+    /// The value, or for `var` declarations a pointer to it (`ptr_ty` set): read at every stop.
+    val: ?Value,
+    ptr_ty: ?Type,
+    block: *Sema.Block,
+    /// The Sema that declared it: comptime allocations belong to one Sema instance.
+    sema: *Sema,
+    frame: u32,
+};
+
+var locals: std.ArrayList(Local) = .empty;
+var stmt_count: u64 = 0;
+var branch_count: u64 = 0;
+
+/// Locals declared inside a body vanish when the body is left.
+pub fn enterBody() usize {
+    return locals.items.len;
+}
+pub fn exitBody(mark: usize) void {
+    locals.shrinkRetainingCapacity(mark);
+}
+
+pub fn frameDepth(block: *const Sema.Block) u32 {
+    var d: u32 = 0;
+    var b: *const Sema.Block = block;
+    while (true) {
+        if (b.inlining) |inl| {
+            d += 1;
+            b = inl.call_block;
+        } else if (b.parent) |p| {
+            b = p;
+        } else break;
+    }
+    return d;
+}
+
+const Where = struct { file: []const u8, base: u32 };
+
+fn where(sema: *Sema) Where {
+    const zcu = sema.pt.zcu;
+    const ip = &zcu.intern_pool;
+    if (sema.func_index != .none) {
+        const info = zcu.funcInfo(sema.func_index);
+        return .{
+            .file = zcu.navFileScope(info.owner_nav).sub_file_path,
+            .base = zcu.navSrcLine(info.owner_nav) + info.lbrace_line,
+        };
+    }
+    switch (sema.owner.unwrap()) {
+        .@"comptime" => |id| {
+            const full = ip.getComptimeUnit(id).zir_index.resolveFull(ip) orelse return .{ .file = "?", .base = 0 };
+            const file = zcu.fileByIndex(full.file);
+            return .{ .file = file.sub_file_path, .base = file.zir.?.getDeclaration(full.inst).src_line };
+        },
+        .nav_val, .nav_ty => |nav| return .{ .file = zcu.navFileScope(nav).sub_file_path, .base = zcu.navSrcLine(nav) },
+        else => return .{ .file = "?", .base = 0 },
+    }
+}
+
+fn fmtValue(sema: *Sema, val: ?Value) []u8 {
+    const v = val orelse return gpa.dupe(u8, "<not comptime-known>") catch @panic("OOM");
+    var buf: [400]u8 = undefined;
+    var w = std.Io.Writer.fixed(&buf);
+    w.print("{f}", .{v.fmtValueSema(sema)}) catch {};
+    return gpa.dupe(u8, w.buffered()) catch @panic("OOM");
+}
+
+pub fn onVar(sema: *Sema, block: *Sema.Block, name: []const u8, val: ?Value, ptr_ty: ?Type) void {
+    locals.append(gpa, .{ .sema = sema, .name = name, .val = val, .ptr_ty = ptr_ty, .block = block, .frame = frameDepth(block) }) catch @panic("OOM");
+}
+
+pub fn onStmt(sema: *Sema, block: *Sema.Block, line: u32, column: u32) void {
+    const w = where(sema);
+    const depth = frameDepth(block);
+    stmt_count += 1;
+    std.debug.print("[zct] stmt #{d} {s}:{d}:{d} depth={d}", .{ stmt_count, w.file, w.base + line + 1, column + 1, depth });
+    var first = true;
+    for (locals.items) |l| {
+        if (l.frame != depth) continue;
+        const v: ?Value = if (l.ptr_ty) |pt| (if (l.val) |pv| l.sema.zctDeref(l.block, pv, pt) else null) else l.val;
+        const text = fmtValue(l.sema, v);
+        defer gpa.free(text);
+        std.debug.print("{s}{s}={s}", .{ if (first) " | " else ", ", l.name, text });
+        first = false;
+    }
+    std.debug.print("\n", .{});
+}
+
+pub fn onBranch(sema: *Sema) void {
+    branch_count += 1;
+    std.debug.print("[zct] backward branch {d}/{d}\n", .{ sema.branch_count, sema.branch_quota });
+}
+
+pub fn onError(sema: *Sema, msg: []const u8) void {
+    _ = sema;
+    std.debug.print("[zct] ERROR raised: {s}\n", .{msg});
+}
+
+pub fn summary() void {
+    std.debug.print("[zct] statements={d} branches={d}\n", .{ stmt_count, branch_count });
+}
