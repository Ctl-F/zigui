/// The settings as the IDE defines them; every field has a default.
pub const Settings = struct {{
{s}}};

/// Presentation hints for one setting. The IDE uses these; the program can ignore them.
pub const Meta = struct {{
    label: ?[]const u8 = null,
    tooltip: ?[]const u8 = null,
    min: ?f64 = null,
    max: ?f64 = null,
    step: ?f64 = null,
    group: ?[]const u8 = null,
    multiline: bool = false,
    hidden: bool = false,
    readonly: bool = false,
    /// For a choice setting: the allowed names.
    choices: ?[]const []const u8 = null,
}};

/// One `Meta` per setting (and per leftover metadata key, so the file always imports).
pub const Metadata = struct {{
{s}}};

/// The whole `<name>.proj.zon`: `@import` it at comptime or parse it at runtime.
pub const File = struct {{
    settings: Settings = .{{}},
    metadata: Metadata = .{{}},
}};
